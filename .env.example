STAR_BACKEND_ADDR=:8080
STAR_CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# 仅用于当前只读开发阶段。开启后任何知道 Steam64 的调用者都可读取该玩家数据。
STAR_SKIP_PASSWORD_AUTH=false

# 游戏服调用 /internal/v1/game-password、/internal/v1/task-events/batch 与 WSS 控制面时使用；须与 Star-Core 的 API Key 一致。
# WSS: GET /internal/v1/ws/game?serverId=<stable-id>&mode=ZM&hostname=...
# 下发: POST /internal/v1/servers/{serverId}/commands
STAR_GAME_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Star-Core 当前使用的 ClientPrefs API；装备配置通过这套服务按模式持久化。
STAR_CLIENT_PREFS_API_URL=https://api.example.com/
STAR_CLIENT_PREFS_API_KEY=CHANGE_ME_TO_THE_STAR_CORE_API_KEY
STAR_CLIENT_PREFS_API_KEY_HEADER=X-Star-Api-Key

# Steam 组成员查询使用 Go 的代理环境变量，不会自动读取 Windows“Internet 选项”代理。
# 在无法直连 steamcommunity.com 的机器上配置 HTTPS_PROXY，并重启后端进程。
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# 推荐使用分离配置；密码中的 @、:、/ 等字符都可以原样填写。
STAR_DB_USER=star_reader
STAR_DB_PASSWORD=CHANGE_ME
STAR_DB_HOST=mysql.example.com
STAR_DB_PORT=3306
STAR_DB_NAME=db_star

# 高级用法：也可改用完整 DSN，并删除上面的 STAR_DB_* 分离字段。
# STAR_DB_DSN=star_reader:CHANGE_ME@tcp(mysql.example.com:3306)/db_star?charset=utf8mb4&parseTime=true&loc=Local&timeout=5s&readTimeout=8s&writeTimeout=8s

# 星尘商店与库存所在的独立只读数据库。
# STAR_DB_CHALLENGE_DSN=challenge_reader:CHANGE_ME@tcp(mysql.example.com:3306)/db_challenge?charset=utf8mb4&parseTime=true&loc=Local&timeout=5s&readTimeout=8s&writeTimeout=8s

# 仅供一次性目录导入命令使用；运行时后端不会读取该写权限 DSN。
# STAR_DB_CHALLENGE_IMPORT_DSN=challenge_writer:CHANGE_ME@tcp(mysql.example.com:3306)/db_challenge?charset=utf8mb4&parseTime=true&loc=Local&timeout=5s&readTimeout=8s&writeTimeout=8s
